---
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { plans } from '../data/pricing';
import { services } from '../data/services';
---

<BaseLayout
  title="Services"
  description="Group classes, personal training, nutrition coaching, recovery work, and open gym access — all under one roof."
>
  <PageHero
    eyebrow="Services &amp; pricing"
    title="Everything you need, one membership."
    subtitle="Pick a service or combine them. Every plan starts with a free trial class, because you should feel the gym before you commit."
    compact
  />

  <section class="section aw-section">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">What we do</p>
        <h2 class="title is-2">Our services</h2>
      </div>

      <div class="columns is-multiline">
        {
          services.map((service) => (
            <div class="column is-4">
              <ServiceCard {...service} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">Membership</p>
        <h2 class="title is-2">Plans that scale with you</h2>
        <p class="subtitle is-6">
          No contracts, cancel anytime, and every plan includes the free trial class.
        </p>
      </div>

      <div class="columns" style="--column-gap: 1.5rem">
        {
          plans.map((plan) => (
            <div class="column is-4">
              <div class:list={['box aw-card aw-plan', { 'is-highlighted': plan.highlighted }]}>
                {plan.highlighted && <div class="aw-plan-badge">Most popular</div>}
                <h3 class="title is-4">{plan.name}</h3>
                <p class="aw-price mb-2">
                  ${plan.price} <span>{plan.period}</span>
                </p>
                <p class="mb-4">{plan.description}</p>
                <ul class="aw-check-list mb-4">
                  {plan.features.map((feature) => <li>{feature}</li>)}
                </ul>
                <a
                  class:list={['button is-fullwidth', plan.highlighted ? 'is-primary' : 'is-outlined']}
                  href="/contact"
                >
                  Start with {plan.name}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Not sure which plan?"
    title="Book a free class and decide later."
    text="Try the floor first. Our coaches will happily recommend the right starting point — and the right plan is the one you will actually use."
  />
</BaseLayout>
