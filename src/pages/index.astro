---
import CtaBand from '../components/CtaBand.astro';
import LatestPosts from '../components/LatestPosts.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { site } from '../data/site';
import { testimonials } from '../data/testimonials';

// Structured data: recognise the business as a local gym / health club.
const healthClubSchema = {
  '@context': 'https://schema.org',
  '@type': 'HealthClub',
  name: site.name,
  description: site.description,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '123 Example Street',
    addressLocality: 'Example City',
    addressRegion: 'EX',
    addressCountry: 'US',
  },
  openingHours: ['Mo-Fr 05:30-23:00', 'Sa 08:00-20:00', 'Su 09:00-18:00'],
};

const featuredServices = services.slice(0, 3);

const stats = [
  { value: '350+', label: 'Active members' },
  { value: '15', label: 'Classes every day' },
  { value: '8', label: 'Certified coaches' },
  { value: '7', label: 'Days a week' },
];
---

<BaseLayout title={site.name} description={site.description} schema={healthClubSchema}>
  <PageHero
    eyebrow="Strength · Conditioning · Recovery"
    title="Train hard. Recover smart."
    subtitle="A no-nonsense gym for people who want real coaching, honest programming, and a routine that fits a busy life."
  >
    <div class="buttons mt-5">
      <a class="button is-primary is-medium" href="/contact">Book a free class</a>
      <a class="button is-medium is-outlined" href="/services">Explore services</a>
    </div>

    <Fragment slot="aside">
      <div class="box aw-hero-box">
        <p class="aw-eyebrow mb-3">This week's classes</p>
        <ul class="content">
          <li><strong>Mon · 07:00</strong> — Strength Circuit</li>
          <li><strong>Wed · 18:00</strong> — HIIT &amp; Core</li>
          <li><strong>Sat · 09:00</strong> — Mobility &amp; Recovery</li>
        </ul>
        <p class="aw-form-note mt-4">Drop-ins welcome while spaces last.</p>
      </div>
    </Fragment>
  </PageHero>

  <section class="section aw-section" aria-label="Gym statistics">
    <div class="container">
      <div class="columns has-text-centered">
        {
          stats.map((stat) => (
            <div class="column">
              <span class="aw-stat-number">{stat.value}</span>
              <span class="aw-stat-label">{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">What we offer</p>
        <h2 class="title is-2">Built around your goals</h2>
        <p class="subtitle is-6">
          Start with one service. Add more only if it genuinely helps you progress.
        </p>
      </div>

      <div class="columns">
        {
          featuredServices.map((service) => (
            <div class="column is-4">
              <ServiceCard {...service} />
            </div>
          ))
        }
      </div>

      <div class="has-text-centered mt-6">
        <a class="button is-medium is-outlined" href="/services">See all services</a>
      </div>
    </div>
  </section>

  <section class="section aw-section">
    <div class="container">
      <div class="columns is-vcentered">
        <div class="column is-7">
          <p class="aw-quote mb-4">
            “We are not here to shout at you. We are here to build you a body
            that handles everything the rest of your week throws at it.”
          </p>
          <p class="has-text-weight-semibold">Mara Ellis, Founder</p>
        </div>
        <div class="column is-5 has-text-centered">
          <a class="button is-primary is-medium" href="/contact">Talk to us first</a>
          <p class="aw-form-note mt-3">A free session, zero pressure to join.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section aw-section aw-section-alt">
    <div class="container">
      <div class="aw-section-head">
        <p class="aw-eyebrow mb-2">Testimonials</p>
        <h2 class="title is-2">What members say</h2>
        <p class="subtitle is-6">Real people, real training — the best marketing is the floor itself.</p>
      </div>

      <div class="columns">
        {
          testimonials.map((testimonial) => (
            <div class="column is-4">
              <TestimonialCard {...testimonial} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <LatestPosts />

  <CtaBand
    eyebrow="Ready when you are"
    title="Start with one free class."
    text="Come try the floor, meet a coach, and see if the vibe fits. No contracts, no sales script."
    ctaLabel="Claim your free class"
    ctaHref="/contact"
  />
</BaseLayout>
