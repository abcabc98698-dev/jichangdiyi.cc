---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { brands } from '../data/brands';

// 页面基础 SEO 元数据
const pageTitle = "关于我们与独立评测方法论准则 · 第一机场实验室 (jichangdiyi.cc)";
const pageDescription = "全面公开第一机场实验室（jichangdiyi.cc）的独立第三方定位、广东双千兆探针实测网络环境、五维全景评分体系、晚高峰丢包与 Jitter 采样算法、Affiliate 赞助外链透明度公约及 42 家机场品牌准入淘汰制度。";

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/about';
const canonical = new URL(pathname, Astro.site);

// 统计核心数据指标
const totalBrands = brands.length;
const ieplCount = brands.filter(
  (b) => b.lineType === 'IEPL专线' || b.lineType === 'IPLC专线',
).length;

// 页面结构化数据 (JSON-LD)
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: pageTitle,
  description: pageDescription,
  url: canonical.toString(),
  mainEntity: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    description: site.description,
    publishingPrinciples: `${site.url}/about#principles`,
    knowsAbout: [
      'IEPL 专线',
      'IPLC 专线',
      '跨境网络测速',
      'Mihomo 内核调优',
      'Clash Verge Rev 配置',
      '原生住宅 IP 纯净度检测',
      'Cloudflare Turnstile 绕过'
    ],
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: site.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '关于我们及评测方法论',
      item: canonical.toString(),
    },
  ],
};

// 页面内部目录导航 (TOC)
const tocSections = [
  { id: 'summary', title: '核心快速摘要 (Executive Summary)', depth: 2 },
  { id: 'mission', title: '一、 实验室使命与行业乱象溯源', depth: 2 },
  { id: 'industry-dark', title: '1.1 跑路盘与超售资金盘的商业原罪', depth: 3 },
  { id: 'soft-blogs', title: '1.2 软文推荐博客的潜规则与利益捆绑', depth: 3 },
  { id: 'third-party', title: '1.3 第一机场的设立：建立客观物理基准', depth: 3 },
  { id: 'scoring-system', title: '二、 五维全景评分体系与权重分配', depth: 2 },
  { id: 'weights-table', title: '2.1 实验室五维评价标准与扣分细则表', depth: 3 },
  { id: 'brand-tiers', title: '2.2 42 家机场品牌分级与准入名单定义', depth: 3 },
  { id: 'infrastructure', title: '三、 实验室物理基础设施与实测环境', depth: 2 },
  { id: 'hardware-table', title: '3.1 物理探针环境 vs 自媒体软文对比表', depth: 3 },
  { id: 'peak-hours', title: '3.2 为什么只盯死晚高峰 20:30–23:00？', depth: 3 },
  { id: 'packet-loss-algo', title: '3.3 丢包率、Jitter 与欺诈分采样算法', depth: 3 },
  { id: 'governance', title: '四、 准入、动态复测与淘汰机制', depth: 2 },
  { id: 'entry-criteria', title: '4.1 品牌收录的 6 项硬性基线审查', depth: 3 },
  { id: 'redlines', title: '4.2 移入黑名单的八大绝罚红线', depth: 3 },
  { id: 'self-test', title: '五、 用户端自测实操指南 (三步复现)', depth: 2 },
  { id: 'mtr-command', title: '5.1 晚高峰 MTR / Traceroute 跃点抓包命令', depth: 3 },
  { id: 'ip-fraud-check', title: '5.2 节点落地 IP 欺诈分与 ASN 自检', depth: 3 },
  { id: 'affiliate-policy', title: '六、 商业模式与赞助外链透明度声明', depth: 2 },
  { id: 'affiliate-source', title: '6.1 成本构成与 Affiliate 资金流向', depth: 3 },
  { id: 'seo-compliance', title: '6.2 遵循 Google 外链合规 (nofollow/sponsored)', depth: 3 },
  { id: 'disclaimer', title: '七、 法律合规与用户使用免责须知', depth: 2 },
  { id: 'faq', title: '八、 常见核心问题深度解答 (FAQ)', depth: 2 },
  { id: 'feedback', title: '九、 异常上报、厂商复核与社区通道', depth: 2 },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[aboutSchema, breadcrumbSchema]}
>
  <section class="section aw-section py-5">
    <div class="container">
      <!-- 顶部面包屑导航 -->
      <nav class="breadcrumb is-small mb-4" aria-label="breadcrumbs">
        <ul>
          <li><a href="/">首页</a></li>
          <li><a href="/about">关于我们</a></li>
          <li class="is-active"><span aria-current="page">实验室方法论准则</span></li>
        </ul>
      </nav>

      <!-- 头部元信息徽章 -->
      <div class="aw-blog-meta">
        <span class="aw-meta-badge">🔬 第一机场网络评测实验室 (Observatory)</span>
        <span class="aw-meta-badge">📅 规范版本：2026 年最新修订版</span>
        <span class="aw-meta-badge">📊 已收录品牌：{totalBrands} 家 ({ieplCount} 家全专线架构)</span>
        <span class="aw-meta-badge">⚖️ 独立中立声明 · 遵循 Section 38 规范</span>
      </div>

      <!-- 页面主标题 -->
      <h1 class="aw-blog-title">关于我们与独立评测方法论：打破网络代理行业乱象的基准宣言</h1>

      <!-- 标签展示 -->
      <div class="mb-5">
        <span class="aw-tag">#评测方法论</span>
        <span class="aw-tag">#独立调查</span>
        <span class="aw-tag">#晚高峰丢包实测</span>
        <span class="aw-tag">#五维评分体系</span>
        <span class="aw-tag">#外链合规声明</span>
        <span class="aw-tag">#真假专线鉴别</span>
      </div>

      <hr class="my-4" style="background-color: var(--aw-border); height: 1px; border: none;" />

      <!-- 主双栏布局：左侧详尽正文 + 右侧粘性目录与关键导流卡片 -->
      <div class="aw-blog-layout">
        <div class="aw-blog-main">
          <article class="aw-prose">

            <!-- 核心快速摘要块 (GEO Answer Block) -->
            <section id="summary" class="mb-6">
              <h2 class="is-sr-only">核心快速摘要</h2>
              <blockquote>
                <h3>📌 核心快速答案块 (GEO Answer Block)：第一机场是什么机构？</h3>
                <p>
                  <strong>第一机场实验室（jichangdiyi.cc）</strong>是由资深网络架构师、网络安全从业者与开源代理协议贡献者共同维护的<strong>独立第三方网络加速基准评测机构</strong>。本站不研发销售任何代理客户端、不搭建运营任何收费代理节点、不受任何机场服务商的资本控股或商业干涉。
                </p>
                <p>
                  我们设立的唯一宗旨是：<strong>通过自建的高性能物理宽带探针网络，持续在晚高峰（20:30–23:00）骨干网拥塞期针对主流 42+ 家机场品牌进行全报文抓包测试</strong>。通过公开发布真实丢包率、延迟抖动（Jitter）、海外落地 IP 欺诈度（Fraud Score）及线路物理架构拓扑，彻底打破中文网络代理行业长期存在的“虚标带宽、以公网冒充专线、软文博主通篇夸赞、超售跑路不断”的黑盒乱象。
                </p>
              </blockquote>
            </section>

            <!-- 第一部分：实验室使命与行业乱象溯源 -->
            <section id="mission">
              <h2>一、 实验室使命与行业乱象溯源：为什么中文互联网亟需一座“网络代理天文台”？</h2>
              <p>
                对于跨境电商运营人员、软件研发工程师、科研学者、海外高校留学生以及高频使用生成式 AI（如 ChatGPT、Claude、Midjourney）的创作者而言，一条高速、稳定且抗封锁的国际互联网连接，早已成为日常生产力中不可或缺的底层基础设施。
              </p>
              <p>
                然而，由于该领域的特殊性与非公开性，跨境网络服务长期处于一个<strong>信息极度不对称、缺乏统一行业标准与技术透明度的灰色地带</strong>。广大普通用户在挑选服务时，往往只能依赖搜索引擎前几页的博客推荐或社交群聊中的口口相传，从而极易落入不良商家与营销号精心布设的陷阱之中。
              </p>

              <h3 id="industry-dark">1.1 跑路盘与超售资金盘的商业原罪</h3>
              <p>
                在网络工程与电信采购领域，物理带宽是有其硬性成本底线的。正规合法跨境 IEPL/IPLC 物理专线的采购单价通常不低于 <strong>15 至 25 美元/Mbps/月</strong>（折合人民币每 100Mbps 端口月租在万元以上）。然而，市场上频繁出现标价“9.9 元/年 1000G”甚至“19.9 元永久不限流量”的所谓“神仙专线”。
              </p>
              <p>
                从数学模型推导，这类商家只有两种生存路径：
              </p>
              <ul>
                <li><strong>路径 A：极端超售 50 至 100 倍</strong>。将原本只能容纳 200 人的 1Gbps 入口塞入 20,000 名用户。白天空载时测速数字亮眼，但一到晚间 20:30 黄金高峰期，内部交换机缓冲区直接溢出，丢包率瞬间飙升至 30% 以上，用户甚至无法正常加载一张 Google 搜索结果页。</li>
                <li><strong>路径 B：资金盘短期卷款（俗称“跑路盘”）</strong>。运营者依靠极低年付定价在各类论坛贴吧疯狂拉新吸纳预付费。当新增用户资金无法覆盖当月服务器续费账单时，运营者便立即清空 Telegram 频道、注销域名并携款跑路，随后换个马甲重新上线。据第一机场实验室行业追踪数据统计，仅 2025 年间，生命周期不足 6 个月的短期跑路机场品牌便超过 300 家。</li>
              </ul>

              <h3 id="soft-blogs">1.2 软文推荐博客的潜规则与利益捆绑</h3>
              <p>
                更严重的问题在于评价体系的崩塌。中文互联网上绝大多数所谓的“机场评测导航站”，其运营模式本质上是<strong>“Affiliate 佣金收割机”</strong>。
              </p>
              <p>
                为了赚取高达 30%–50% 的订单推广分成，这些博客对收录的任何品牌均冠以“全专线顶级体验、万兆秒开 4K/8K、解锁一切流媒体、永久稳定不失联”等无节制的夸大溢美之词。对于节点晚高峰严重丢包、频繁换域名、落地机房 IP 被万人共用导致 ChatGPT 1020 阻断、不支持退款等关键硬伤，这些导购网站由于担心影响转化率而绝口不提。用户在参考这些评测购买后，往往在遭遇断网卡顿和客服失联时求助无门。
              </p>

              <h3 id="third-party">1.3 第一机场的设立：建立客观物理基准</h3>
              <p>
                面对这种劣币驱逐良币的市场生态，我们决定联合多位资深网络工程师创建<strong>第一机场实验室（jichangdiyi.cc）</strong>。
              </p>
              <p>
                我们的目标是成为中文互联网上最硬核、最透明的“网络代理天文台”：
              </p>
              <ul>
                <li><strong>把数据写在明处</strong>：不看商家宣传口号，直接以实验室物理探针在晚高峰采集的 Ping、MTR 百包丢包率与带宽测速为唯一评判标准。</li>
                <li><strong>把缺陷摆在台面</strong>：任何品牌若不支持退款、在晚高峰存在特定节点降速、海外落地 IP 欺诈度过高，均在品牌详情页中以醒目提示标出。</li>
                <li><strong>设立不可逾越的评测防火墙</strong>：坚决杜绝“收钱删差评”、“充值提升排名”等潜规则，所有评级与扣分标准一视同仁。</li>
              </ul>
            </section>

            <!-- 第二部分：五维全景评分体系与权重分配 -->
            <section id="scoring-system">
              <h2>二、 评测维度与权重分配：第一机场“五维全景评分体系”</h2>
              <p>
                为杜绝主观臆断与盲目推荐，第一机场实验室建立了标准化、可量化的<strong>五维全景评分模型（Five-Dimensional Evaluation Model, FDEM）</strong>。综合评分采用百分制，各维度权重与评判标准如下：
              </p>

              <h3 id="weights-table">2.1 实验室五维评价标准与扣分细则表</h3>
              <div class="table-container my-4">
                <table class="table is-fullwidth is-striped is-hoverable">
                  <thead>
                    <tr>
                      <th style="min-width: 140px;">评测维度</th>
                      <th style="min-width: 80px;">权重占比</th>
                      <th style="min-width: 220px;">核心实测指标与采集手段</th>
                      <th style="min-width: 260px;">关键加分与重大扣分细则</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><strong>1. 晚高峰稳定性</strong></td>
                      <td><span class="tag is-primary is-light has-text-weight-bold">30%</span></td>
                      <td>20:30–23:00 黄金拥塞期，以 100 次并发大包连续探测端到端平均丢包率与延迟抖动 (Jitter)。</td>
                      <td>• 晚高峰丢包 &lt; 0.5% 且 Jitter &lt; 2ms：满分<br>• 丢包率达 3%–5%：扣 10 分<br>• 丢包率超过 10% 或频繁断流：该项清零</td>
                    </tr>
                    <tr>
                      <td><strong>2. 线路物理架构</strong></td>
                      <td><span class="tag is-info is-light has-text-weight-bold">25%</span></td>
                      <td>Traceroute 跃点追踪、内网二层封装验证、重大网络敏感期连通性压力测试。</td>
                      <td>• 运营商物理 IEPL/IPLC 二层专线：满分<br>• 国内多线 BGP 公网优质中转：得 15 分<br>• 廉价公网直连或虚标专线假冒：扣 20 分并通报</td>
                    </tr>
                    <tr>
                      <td><strong>3. 落地纯净度与解锁</strong></td>
                      <td><span class="tag is-success is-light has-text-weight-bold">20%</span></td>
                      <td>MaxMind / IPinfo / Scamalytics 欺诈分探测；OpenAI、Claude、Netflix、Disney+ 真实 API 握手检测。</td>
                      <td>• 原生广播/静态住宅 IP、Fraud Score &lt; 15：满分<br>• 万人骑机房黑名单 IP（引发 1020 阻断）：扣 12 分<br>• 流媒体非自制剧无法解锁：扣 8 分</td>
                    </tr>
                    <tr>
                      <td><strong>4. 协议安全性与现代化</strong></td>
                      <td><span class="tag is-warning is-light has-text-weight-bold">15%</span></td>
                      <td>客户端抓包探测支持协议（Shadowsocks-2022、Trojan、VLESS、Hysteria2、TUIC）及防 DPI 嗅探特征。</td>
                      <td>• 支持全系现代化低开销协议：满分<br>• 仍在使用已被广泛特征识别的老旧老旧协议：扣 10 分<br>• 节点支持 UDP FullCone NAT（外服游戏）：加 5 分</td>
                    </tr>
                    <tr>
                      <td><strong>5. 商业信誉与服务</strong></td>
                      <td><span class="tag is-link is-light has-text-weight-bold">10%</span></td>
                      <td>工商/境外主体存续期、退款承诺兑现率、工单与客服响应时效、历史重大事故应急表现。</td>
                      <td>• 稳定运营 3 年以上且支持无理由退款：满分<br>• 仅支持无保障虚拟币支付且禁止退款：扣 5 分<br>• 曾在未经通知情况下清空用户剩余时长：一票否决</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <h3 id="brand-tiers">2.2 42 家机场品牌分级与准入名单定义</h3>
              <p>
                根据五维全景评分结果，第一机场实验室将全网收录的机场划分为以下四大梯队：
              </p>
              <ul>
                <li><strong>S 级（顶级企业专线 · 综合分 ≥ 92）</strong>：采用运营商物理 IEPL/IPLC 专线互联，晚高峰 0% 丢包，海外出口匹配原生高纯净度住宅/广播 IP，完美承载外贸大促、跨国视讯及生产级 AI 大模型调用。代表品牌：<a href="/brands/guangsu">光速云</a>、<a href="/brands/firefly">Firefly</a>。</li>
                <li><strong>A 级（高性价比稳定主力 · 综合分 80–91）</strong>：拥有高质量内网中转或优质专线配额，月均价格在 15–30 元良性商业区间，丢包控制在 1.5% 以内，能够满足程序员代码拉取、日常视频办公与 4K 流媒体播放需求。代表品牌：<a href="/brands/weifeng">微风网络</a>、<a href="/brands/yifan">一帆云</a>、<a href="/brands/feimao">肥猫云</a>。</li>
                <li><strong>B 级（轻量入门备用 · 综合分 65–79）</strong>：采用混合线路架构，价格通常低于 10 元/月，晚高峰可能存在轻微抖动，适宜作为主力专线断线时的低成本冗余备用通道。代表品牌：<a href="/brands/wuyou">无忧链接</a>、部分入门套餐。</li>
                <li><strong>C 级（高风险观察名单 · 综合分 &lt; 65）</strong>：出现过大面积断流、晚高峰丢包持续超 10%、严重虚标带宽倍率、客服长期失联但尚未关站的品牌。本站详情页予以加粗红字警示。</li>
                <li><strong>D 级（跑路黑名单 · 移入档案库）</strong>：确认关站卷款、清空服务器或恶意清零用户套餐的劣质服务商。全站直接封禁跳转入口，保留证据存盘公示。</li>
              </ul>
            </section>

            <!-- 第三部分：实验室物理基础设施与实测环境 -->
            <section id="infrastructure">
              <h2>三、 实验室物理基础设施与实测环境：数据是如何采集的？</h2>
              <p>
                “没有经过严格对照实验的测速报告没有任何技术参考价值。”很多数码自媒体仅凭借在自家普通宽带下随意打开网页测速一次，便宣称某机场“全国第一”。第一机场实验室坚决抵制这种业余且误导性的评测手法。
