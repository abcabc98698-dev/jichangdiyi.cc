---
import BlogCard from '../../components/BlogCard.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../../utils/reading-time';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog"
  description="Practical notes on training, recovery, and nutrition from the Astro Wellness coaches."
>
  <PageHero
    eyebrow="Wellness journal"
    title="Notes from the gym floor."
    subtitle="No fitness-industry noise — just practical advice on training, recovery, and nutrition that survives contact with real life."
    compact
  />

  <section class="section aw-section">
    <div class="container">
      {
        posts.length > 0 ? (
          <div class="columns is-multiline">
            {
              posts.map((post) => (
                <div class="column is-4">
                  <BlogCard
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    tags={post.data.tags}
                    href={`/blog/${post.id}/`}
                    readingTime={readingTime(post.body ?? '')}
                  />
                </div>
              ))
            }
          </div>
        ) : (
          <p class="has-text-centered">
            No posts yet. Check back soon — or <a href="/contact">tell us</a> what
            you would like us to write about.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
