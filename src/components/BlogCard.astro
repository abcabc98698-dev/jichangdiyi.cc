---
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  href: string;
  readingTime: string;
}

const { title, description, pubDate, tags, href, readingTime } = Astro.props;
---

<article class="card aw-card aw-card--link">
  <div class="card-content aw-card-content is-flex is-flex-direction-column">
    <p class="aw-blog-meta mb-2">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {' · '}
      {readingTime}
    </p>
    <h2 class="title is-4">
      <a class="aw-card-link" href={href}>{title}</a>
    </h2>
    <p class="mb-4">{description}</p>
    <div class="mb-4">
      {tags.map((tag) => <span class="aw-tag">#{tag}</span>)}
    </div>
    <p class="aw-card-format">Read article →</p>
  </div>
</article>
