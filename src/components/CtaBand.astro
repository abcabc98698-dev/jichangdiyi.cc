---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, title, text, ctaLabel = 'Book a free class', ctaHref = '/contact' } = Astro.props;
---

<section class="section aw-section">
  <div class="container">
    <div class="aw-cta has-text-centered">
      {eyebrow && <p class="aw-eyebrow mb-3">{eyebrow}</p>}
      <h2 class="title is-2 mb-3">{title}</h2>
      {text && <p class="subtitle is-5 mb-5 aw-cta-text">{text}</p>}
      <a class="button is-primary is-large" href={ctaHref}>{ctaLabel}</a>
    </div>
  </div>
</section>
