---
import type { Service } from '../data/services';

interface Props extends Service {}

const { title, description, details, format } = Astro.props;
---

<article class="card aw-card">
  <div class="card-content aw-card-content is-flex is-flex-direction-column">
    <h3 class="title is-4">{title}</h3>
    <p class="mb-4">{description}</p>
    <ul class="aw-check-list mb-4">
      {details.map((item) => <li>{item}</li>)}
    </ul>
    <p class="aw-card-format">{format}</p>
  </div>
</article>
