---
import ThemeToggle from './ThemeToggle.astro';
import { navItems, site } from '../data/site';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---

<header>
  <nav class="navbar aw-navbar" aria-label="Main navigation">
    <div class="container">
      <div class="navbar-brand">
        <a class="navbar-item aw-brand" href="/">
          <span class="aw-brand-mark" aria-hidden="true">
            {/* Simple dumbbell mark — swap for your own logo if you have one. */}
            <svg viewBox="0 0 24 24" fill="currentColor">
              <rect x="2" y="9" width="3" height="6" rx="1" />
              <rect x="19" y="9" width="3" height="6" rx="1" />
              <rect x="6" y="7.5" width="2.5" height="9" rx="1" />
              <rect x="15.5" y="7.5" width="2.5" height="9" rx="1" />
              <rect x="7.5" y="10.5" width="9" height="3" rx="1.5" />
            </svg>
          </span>
          {site.name}
        </a>

        <button
          type="button"
          class="navbar-burger"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="main-navbar"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>

      <div id="main-navbar" class="navbar-menu">
        <div class="navbar-end">
          {
            navItems.map((item) => (
              <a
                class:list={['navbar-item', { 'is-active': isActive(item.href) }]}
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <div class="navbar-item">
            <ThemeToggle />
          </div>
          <div class="navbar-item">
            <a class="button is-primary" href="/contact">Book a free class</a>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Bulma ships without JS, so the mobile menu toggle lives here.
  // Document-level delegation + fresh queries: with <ClientRouter /> the menu
  // DOM is re-created on every client-side navigation, but this listener and
  // the getElementById lookup still work because they resolve elements per event.
  const closeMenu = () => {
    const burger = document.querySelector<HTMLElement>('.navbar-burger');
    const menu = document.getElementById('main-navbar');
    const wasOpen = burger?.getAttribute('aria-expanded') === 'true';
    burger?.setAttribute('aria-expanded', 'false');
    burger?.setAttribute('aria-label', 'Open menu');
    burger?.classList.remove('is-active');
    menu?.classList.remove('is-active');
    // Return focus to the trigger when the menu was open (Escape / outside click).
    if (wasOpen && document.activeElement instanceof HTMLElement) {
      burger?.focus();
    }
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const burger = target.closest('.navbar-burger');
    if (burger) {
      const isOpen = burger.getAttribute('aria-expanded') === 'true';
      const menu = document.getElementById('main-navbar');
      burger.setAttribute('aria-expanded', String(!isOpen));
      burger.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
      burger.classList.toggle('is-active', !isOpen);
      menu?.classList.toggle('is-active', !isOpen);
      return;
    }

    // Close the menu when a link is chosen or the click lands outside the navbar.
    if (target.closest('#main-navbar a') || !target.closest('.navbar')) {
      closeMenu();
    }
  });

  // Close the menu with Escape.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
