---
import ThemeToggle from './ThemeToggle.astro';
import { navItems, site } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string): boolean {
  const cleanHref = href.replace(/\/+$/, '') || '/';
  return cleanHref === '/' ? currentPath === '/' : currentPath.startsWith(cleanHref);
}
---

<header>
  <nav class="navbar aw-navbar" aria-label="Main navigation">
    <div class="container">
      <div class="navbar-brand">
        <a class="navbar-item aw-brand" href="/">
          <span class="aw-brand-mark" aria-hidden="true">
            <!-- 第一机场雷达/专线信号微标 -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a10 10 0 0 1 10 10 10 10 0 0 1-10 10A10 10 0 0 1 2 12 10 10 0 0 1 12 2z"></path>
              <path d="M12 6a6 6 0 0 1 6 6 6 6 0 0 1-6 6 6 6 0 0 1-6-6 6 6 0 0 1 6-6z"></path>
              <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
              <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
            </svg>
          </span>
          {site.name}
        </a>

        <button
          type="button"
          class="navbar-burger"
          aria-label="打开菜单"
          aria-expanded="false"
          aria-controls="main-navbar"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>

      <div id="main-navbar" class="navbar-menu">
        <div class="navbar-end">
          {
            navItems.map((item) => (
              <a
                class:list={['navbar-item', { 'is-active': isActive(item.href) }]}
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <div class="navbar-item">
            <ThemeToggle />
          </div>
          <div class="navbar-item">
            <a class="button is-primary" href="/brands">进入品牌库</a>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const closeMenu = () => {
    const burger = document.querySelector<HTMLElement>('.navbar-burger');
    const menu = document.getElementById('main-navbar');
    const wasOpen = burger?.getAttribute('aria-expanded') === 'true';
    burger?.setAttribute('aria-expanded', 'false');
    burger?.setAttribute('aria-label', '打开菜单');
    burger?.classList.remove('is-active');
    menu?.classList.remove('is-active');
    if (wasOpen && document.activeElement instanceof HTMLElement) {
      burger?.focus();
    }
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const burger = target.closest('.navbar-burger');
    if (burger) {
      const isOpen = burger.getAttribute('aria-expanded') === 'true';
      const menu = document.getElementById('main-navbar');
      burger.setAttribute('aria-expanded', String(!isOpen));
      burger.setAttribute('aria-label', isOpen ? '打开菜单' : '关闭菜单');
      burger.classList.toggle('is-active', !isOpen);
      menu?.classList.toggle('is-active', !isOpen);
      return;
    }

    if (target.closest('#main-navbar a') || !target.closest('.navbar')) {
      closeMenu();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
