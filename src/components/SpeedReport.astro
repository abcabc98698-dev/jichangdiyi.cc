---
import type { SpeedNode } from '../data/brands';

interface Props {
  brandName: string;
  testDate?: string;
  nodes?: Record<string, SpeedNode>;
  note?: string;
}

const {
  brandName,
  testDate = '2026-10-19 晚高峰实测',
  nodes,
  note = '全节点 IEPL/IPLC 内网专线传输，端到端加密，晚高峰 0% 丢包率基准',
} = Astro.props;

// 解析数字用于渲染进度条（以 600Mbps 为基准 100%）
function getBarWidth(downloadStr: string): number {
  const match = downloadStr.match(/(\d+(\.\d+)?)/);
  if (!match) return 30;
  const val = parseFloat(match[1]);
  return Math.min(100, Math.max(10, Math.round((val / 600) * 100)));
}
---

<div class="box aw-speed-box">
  <div class="aw-speed-header is-flex is-justify-content-between is-align-items-center mb-3">
    <div>
      <span class="aw-speed-badge">Performance Monitoring Report</span>
      <h3 class="title is-5 mb-0 mt-1">{brandName} 晚高峰网络实测报告</h3>
    </div>
    <div class="has-text-right">
      <span class="is-size-7 aw-speed-muted">{testDate}</span>
    </div>
  </div>

  <div class="aw-speed-env mb-3 p-2">
    <p class="is-size-7 mb-0">
      <strong>测试环境：</strong>广东/珠海电信·联通千兆宽带双线 | <strong>工具：</strong>Speedtest.net / Clash Verge Rev
    </p>
  </div>

  {
    nodes ? (
      <div class="aw-speed-nodes">
        {Object.entries(nodes).map(([nodeName, data]) => {
          const width = getBarWidth(data.download);
          return (
            <div class="aw-speed-node-row mb-3">
              <div class="is-flex is-justify-content-between is-size-7 mb-1">
                <span class="has-text-weight-bold">
                  <span class="aw-status-dot is-online" />
                  {nodeName}
                </span>
                <span>
                  延迟: <strong class="has-text-primary">{data.ping}</strong> · 下行:{' '}
                  <strong class="has-text-info">{data.download}</strong>
                </span>
              </div>
              <div class="aw-progress-track">
                <div class="aw-progress-bar" style={`width: ${width}%`} />
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="p-4 has-text-centered is-size-7 aw-speed-muted">
        该品牌当前基于厂商官方公开技术参数，实验室逐节点测速数据采集中。
      </div>
    )
  }

  <div class="aw-speed-footer is-flex is-justify-content-between is-align-items-center mt-3 pt-2">
    <p class="is-size-7 aw-speed-muted mb-0">{note}</p>
    <span class="aw-speed-watermark">[jichangdiyi.cc]</span>
  </div>
</div>

<style>
  .aw-speed-box {
    background-color: var(--aw-ink-raised);
    border: 1px solid var(--aw-border);
    border-radius: 0.75rem;
    color: var(--aw-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }
  .aw-speed-box .title {
    color: var(--aw-text) !important;
  }
  .aw-speed-box strong {
    color: var(--aw-text) !important;
  }
  .aw-speed-muted {
    color: var(--aw-muted);
  }
  .aw-speed-badge {
    display: inline-block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(0, 230, 118, 0.12);
    color: #00e676;
    border: 1px solid rgba(0, 230, 118, 0.3);
  }
  .aw-speed-env {
    background: var(--aw-stripes);
    border-radius: 4px;
    border-left: 3px solid var(--aw-accent);
    color: var(--aw-text);
  }
  .aw-status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-right: 6px;
    background-color: #00e676;
    box-shadow: 0 0 6px #00e676;
  }
  .aw-progress-track {
    height: 8px;
    background: var(--aw-stripes);
    border: 1px solid var(--aw-border);
    border-radius: 4px;
    overflow: hidden;
  }
  .aw-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #00e676, #00b0ff);
    border-radius: 4px;
    transition: width 0.3s ease;
  }
  .aw-speed-footer {
    border-top: 1px dashed var(--aw-border);
  }
  .aw-speed-watermark {
    font-size: 0.7rem;
    color: var(--aw-muted);
    letter-spacing: 0.05em;
  }
</style>
