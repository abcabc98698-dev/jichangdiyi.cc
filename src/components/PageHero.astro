---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  compact?: boolean;
}

const { eyebrow, title, subtitle, compact = false } = Astro.props;
---

<section class:list={['hero', 'aw-hero', { 'is-medium': !compact }]}>
  <div class="hero-body">
    <div class="container">
      <div class:list={['columns is-vcentered', { 'is-centered': compact }]}>
        <div class:list={['column', compact ? 'is-two-thirds has-text-centered' : 'is-three-fifths']}>
          {eyebrow && <p class="aw-eyebrow mb-3">{eyebrow}</p>}
          <h1 class:list={['aw-display', 'mb-4']}>{title}</h1>
          {subtitle && (
            <p class:list={['subtitle is-5', { 'mx-auto': compact }]}>{subtitle}</p>
          )}
          {Astro.slots.has('default') && (
            <div class:list={['aw-hero-lead', { 'mx-auto': compact }]}>
              <slot />
            </div>
          )}
        </div>
        {
          !compact && (
            <div class="column is-two-fifths">
              <slot name="aside" />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
